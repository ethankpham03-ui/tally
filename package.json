{
  "name": "tally-finance",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first personal finance tracker for cash flow, budgets, and recurring subscriptions.",
  "homepage": "https://tally.ethankpham.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethankpham03-ui/tally.git"
  },
  "bugs": {
    "url": "https://github.com/ethankpham03-ui/tally/issues"
  },
  "keywords": [
    "personal-finance",
    "expense-tracker",
    "budgeting",
    "subscription-manager",
    "local-first",
    "react",
    "typescript"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:coverage": "node --test --experimental-strip-types --experimental-test-coverage tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "deploy": "vinext-cloudflare deploy --name tally"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.0",
    "@cloudflare/workers-types": "5.20260928.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.3.1",
    "wrangler": "4.143.0"
  },
  "type": "module"
}
